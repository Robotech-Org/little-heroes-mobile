<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Little Heroes Mobile</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.robotech.littleheroes.app</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>little_heroes_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	
	<!-- UPDATED: Added payment configurations to mirror the Android Manifest queries block -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
		<string>tel</string>
		<string>mailto</string>
		<string>googlegmail</string>
		<string>google</string>
		<string>chapa</string>
	</array>
	
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.robotech.littleheroes.app.backgroundtask</string>
	</array>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	
	<!-- APPLE COMPLIANT PERMISSION STRINGS -->
	<key>NSCameraUsageDescription</key>
	<string>Little Heroes requires camera access for teachers to scan student IDs and QR codes to take attendance within the school compound.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Little Heroes requires location access to verify that teachers are physically within the school compound boundaries when scanning student attendance.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Little Heroes requires location access to verify that teachers are physically within the school compound boundaries when scanning student attendance.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Little Heroes requires location access to verify that teachers are physically within the school compound boundaries when scanning student attendance.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Little Heroes requires photo library write access to allow school administrators to save reports and student profile photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Little Heroes requires photo library access to allow school administrators to choose student and teacher profile images.</string>
	
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	
	
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>processing</string>
	</array>
	
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
